<ui:UXML xmlns:ui="UnityEngine.UIElements">
  <ui:Style src="Shared.uss" />
  <ui:Style src="Preparation.uss" />
  <ui:Style src="UpgradeGraph.uss" />
  <ui:VisualElement name="PreparationScreen" class="prep-screen">
    <ui:VisualElement class="prep-main">
      <ui:VisualElement class="prep-header">
        <ui:VisualElement class="prep-header-titles">
          <ui:Label text="C O T T O N   C I R C U I T" class="prep-eyebrow" />
          <ui:Label text="내일의 달콤함" class="prep-title"><Bindings><CottonCircuit.LocalizedText property="text" key="prep.title" /></Bindings></ui:Label>
        </ui:VisualElement>
        <ui:VisualElement class="prep-wallet-group">
          <ui:Label name="PreparationDay" text="DAY 01  /  Prep" class="prep-day" />
          <ui:Label name="PreparationWallet" text="80 C" class="prep-wallet" />
        </ui:VisualElement>
      </ui:VisualElement>
      <ui:VisualElement name="UpgradeGraphPage" class="prep-page prep-graph-paper">
        <ui:VisualElement class="prep-page-heading">
          <ui:Label text="성장 지도" class="prep-section-title"><Bindings><CottonCircuit.LocalizedText property="text" key="prep.growth.map" /></Bindings></ui:Label>
          <ui:Label name="PreparationTraitCount" text="0 / 6 unlocked" class="prep-muted" />
        </ui:VisualElement>
        <ui:VisualElement class="prep-trait-tabs">
          <ui:Button name="TraitTab_business" text="가게 운영" class="prep-button prep-trait-tab prep-selected"><Bindings><CottonCircuit.LocalizedText property="text" key="tab.business" /></Bindings></ui:Button>
          <ui:Button name="TraitTab_production" text="솜사탕 제작" class="prep-button prep-trait-tab"><Bindings><CottonCircuit.LocalizedText property="text" key="tab.production" /></Bindings></ui:Button>
          <ui:Button name="TraitTab_machines" text="기계와 맛" class="prep-button prep-trait-tab"><Bindings><CottonCircuit.LocalizedText property="text" key="tab.machines" /></Bindings></ui:Button>
          <ui:Button name="TraitTab_staff" text="알바" class="prep-button prep-trait-tab"><Bindings><CottonCircuit.LocalizedText property="text" key="tab.staff" /></Bindings></ui:Button>
          <ui:Button name="TraitTab_sales" text="장소와 판매" class="prep-button prep-trait-tab"><Bindings><CottonCircuit.LocalizedText property="text" key="tab.sales" /></Bindings></ui:Button>
          <ui:Button name="TraitTab_kart" text="차량" class="prep-button prep-trait-tab"><Bindings><CottonCircuit.LocalizedText property="text" key="tab.kart" /></Bindings></ui:Button>
        </ui:VisualElement>
        <ui:VisualElement name="TraitGraphArea" class="trait-graph-area">
          <ui:VisualElement name="TraitGraph_business" class="trait-graph">
            <ui:VisualElement name="TraitEdge_ads_group_visit" class="trait-edge" picking-mode="Ignore">
              <ui:VisualElement class="trait-edge-head trait-edge-head-left" picking-mode="Ignore" />
              <ui:VisualElement class="trait-edge-head trait-edge-head-right" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="TraitEdge_ads_repeat_ads" class="trait-edge" picking-mode="Ignore">
              <ui:VisualElement class="trait-edge-head trait-edge-head-left" picking-mode="Ignore" />
              <ui:VisualElement class="trait-edge-head trait-edge-head-right" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="TraitNode_hours" class="trait-node trait-cat-business">
              <ui:Button name="UpgradeNode_hours" class="trait-node-button">
                <ui:VisualElement class="trait-ring" picking-mode="Ignore">
                  <ui:VisualElement class="trait-disc" picking-mode="Ignore"><ui:VisualElement name="TraitIcon_hours" class="trait-icon prep-icon-Trait_Hours" picking-mode="Ignore" /></ui:VisualElement>
                  <ui:Label name="TraitRank_hours" text="0/3" class="trait-rank" picking-mode="Ignore" />
                </ui:VisualElement>
              </ui:Button>
              <ui:Label text="영업시간" class="trait-name" picking-mode="Ignore"><Bindings><CottonCircuit.LocalizedText property="text" key="trait.hours.name" /></Bindings></ui:Label>
            </ui:VisualElement>
            <ui:VisualElement name="TraitNode_patience" class="trait-node trait-cat-business">
              <ui:Button name="UpgradeNode_patience" class="trait-node-button">
