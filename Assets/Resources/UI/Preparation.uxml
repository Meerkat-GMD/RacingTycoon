<ui:UXML xmlns:ui="UnityEngine.UIElements">
  <ui:Style src="Shared.uss" />
  <ui:Style src="Preparation.uss" />
  <ui:VisualElement name="PreparationScreen" class="prep-screen">
    <ui:VisualElement class="prep-main">
      <ui:VisualElement class="prep-header">
        <ui:VisualElement class="prep-header-titles">
          <ui:Label text="C O T T O N   C I R C U I T" class="prep-eyebrow" />
          <ui:Label text="내일의 달콤함" class="prep-title" />
        </ui:VisualElement>
        <ui:VisualElement class="prep-wallet-group">
          <ui:Label name="PreparationDay" text="DAY 01  /  영업 준비" class="prep-day" />
          <ui:Label name="PreparationWallet" text="80 C" class="prep-wallet" />
        </ui:VisualElement>
      </ui:VisualElement>
      <ui:VisualElement name="UpgradeGraphPage" class="prep-page">
        <ui:VisualElement class="prep-page-heading">
          <ui:Label text="성장 지도" class="prep-section-title" />
          <ui:Label text="한 단계씩, 우리만의 가게로" class="prep-muted" />
        </ui:VisualElement>
        <ui:VisualElement class="prep-trait-tabs">
          <ui:Button name="TraitTab_business" text="가게 운영" class="prep-button prep-trait-tab prep-selected" />
          <ui:Button name="TraitTab_production" text="솜사탕 제작" class="prep-button prep-trait-tab" />
          <ui:Button name="TraitTab_machines" text="기계와 맛" class="prep-button prep-trait-tab" />
          <ui:Button name="TraitTab_staff" text="알바" class="prep-button prep-trait-tab" />
          <ui:Button name="TraitTab_sales" text="장소와 판매" class="prep-button prep-trait-tab" />
          <ui:Button name="TraitTab_kart" text="차량" class="prep-button prep-trait-tab" />
        </ui:VisualElement>
        <ui:VisualElement class="prep-category-heading">
          <ui:Label name="PreparationCategoryTitle" text="가게 운영" class="prep-category-title" />
          <ui:Label name="PreparationTraitCount" text="0 / 6 해금" class="prep-muted" />
        </ui:VisualElement>
        <ui:ScrollView name="UpgradeGraphScroll" class="prep-scroll" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Auto">
          <ui:VisualElement name="TraitMap" class="prep-trait-grid">
            <ui:VisualElement name="TraitCard_hours" class="prep-trait-card">
              <ui:VisualElement class="prep-trait-header"><ui:VisualElement name="TraitIcon_hours" class="prep-trait-icon prep-icon-Trait_Hours" picking-mode="Ignore" /><ui:VisualElement class="prep-trait-title-group"><ui:Label text="영업시간" class="prep-trait-name" /><ui:Label name="TraitRank_hours" text="0 / 1" class="prep-trait-rank" /></ui:VisualElement></ui:VisualElement>
              <ui:Label name="TraitDescription_hours" text="하루 영업시간이 단계마다 40초 늘어납니다." class="prep-trait-description" />
              <ui:Label name="TraitEffect_hours" text="현재 효과와 다음 단계 효과" class="prep-trait-effect" />
              <ui:Label name="TraitAvailability_hours" text="가게의 새로운 가능성을 열어 보세요." class="prep-trait-availability" />
              <ui:Button name="UpgradeNode_hours" text="해금" class="prep-button prep-primary prep-trait-purchase" />
            </ui:VisualElement>
            <ui:VisualElement name="TraitCard_patience" class="prep-trait-card">
