.title-screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    color: #29324d;
}
.title-background {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-image: url("project://database/Assets/CottonCircuit/Sprites/Title/TitleBackground.png");
    background-size: cover;
    background-position: center;
}
.title-content {
    flex-grow: 1;
    justify-content: center;
    padding: 42px 72px;
}
.title-word {
    font-size: 82px;
    -unity-font-style: bold;
    margin: 0;
    padding: 0;
}
.title-word-accent {
    color: #c9678a;
    font-size: 92px;
    margin-top: -12px;
}
.title-tagline {
    color: #626573;
    font-size: 20px;
    white-space: normal;
    margin-top: 14px;
    margin-bottom: 28px;
}
.title-saved-note {
    color: #777180;
    font-size: 16px;
    white-space: normal;
    margin-top: 5px;
}
.title-error {
    color: #9a3c56;
    font-size: 17px;
    white-space: normal;
    margin-top: 10px;
}
.title-footer {
    position: absolute;
    left: 82px;
    bottom: 14px;
    font-size: 14px;
    color: #505b67;
    background-color: rgba(255, 246, 231, 0.9);
    border-radius: 9px;
    padding: 6px 12px;
}
.title-confirmation {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(31, 38, 56, 0.66);
}
.title-confirmation-card {
    width: 620px;
    max-width: 90%;
    padding: 38px;
    background-color: #fff6e7;
    border-radius: 24px;
}
.title-confirmation-heading {
    font-size: 31px;
    -unity-font-style: bold;
    margin-bottom: 24px;
}
.title-confirmation-copy {
    font-size: 22px;
    color: #636573;
    white-space: normal;
    margin-bottom: 34px;
}
.title-confirmation-actions { flex-direction: row; }
.title-confirmation-actions > .menu-button {
    flex-grow: 1;
    flex-basis: 0;
    margin-bottom: 0;
    -unity-text-align: middle-center;
}
.title-confirmation-actions > .menu-button-primary { margin-left: 14px; }
