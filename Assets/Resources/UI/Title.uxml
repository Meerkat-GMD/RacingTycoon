<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="Shared.uss" />
    <ui:Style src="Menu.uss" />
    <ui:Style src="Title.uss" />
    <ui:VisualElement name="TitleScreen" class="title-screen">
        <ui:VisualElement name="TitleBackground" class="title-background" picking-mode="Ignore" />
        <ui:VisualElement class="title-content" picking-mode="Ignore">
            <ui:VisualElement name="TitleMenu" class="menu-card">
                <ui:Label text="C O T T O N   C I R C U I T" class="menu-eyebrow" picking-mode="Ignore">
                    <Bindings>
                        <CottonCircuit.LocalizedText property="text" key="title.eyebrow" />
                    </Bindings>
                </ui:Label>
                <ui:Label text="솜사탕" class="title-word" picking-mode="Ignore">
                    <Bindings>
                        <CottonCircuit.LocalizedText property="text" key="title.word.first" />
                    </Bindings>
                </ui:Label>
                <ui:Label text="서킷" class="title-word title-word-accent" picking-mode="Ignore">
                    <Bindings>
                        <CottonCircuit.LocalizedText property="text" key="title.word.second" />
                    </Bindings>
                </ui:Label>
                <ui:Label text="달리고, 만들고, 나만의 달콤한 가게." class="title-tagline" picking-mode="Ignore">
                    <Bindings>
                        <CottonCircuit.LocalizedText property="text" key="title.tagline" />
                    </Bindings>
                </ui:Label>
                <ui:Button name="TitlePrimaryButton" text="Start game" class="menu-button menu-button-primary">
                    <ui:VisualElement class="menu-action-icon" picking-mode="Ignore" />
                </ui:Button>
                <ui:Button name="TitleNewGameButton" text="새 게임" class="menu-button">
                    <Bindings>
                        <CottonCircuit.LocalizedText property="text" key="title.new" />
                    </Bindings>
                </ui:Button>
                <ui:Button name="TitleSettingsButton" text="설정" class="menu-button">
                    <Bindings>
                        <CottonCircuit.LocalizedText property="text" key="settings.open" />
                    </Bindings>
                </ui:Button>
                <ui:Button name="TitleQuitButton" text="게임 종료" class="menu-button">
                    <Bindings>
                        <CottonCircuit.LocalizedText property="text" key="title.quit" />
                    </Bindings>
                </ui:Button>
                <ui:Label name="TitleSavedNote" text="Ready to open your first cotton candy shop?" class="title-saved-note" picking-mode="Ignore" />
                <ui:Label name="TitleError" class="title-error hidden" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Label text="↑ ↓  메뉴 선택     Enter  선택" class="title-footer" picking-mode="Ignore">
            <Bindings>
                <CottonCircuit.LocalizedText property="text" key="title.footer" />
            </Bindings>
        </ui:Label>
        <ui:VisualElement name="TitleConfirmation" class="title-confirmation hidden">
            <ui:VisualElement class="title-confirmation-card">
                <ui:Label text="새로운 가게를 열까요?" class="title-confirmation-heading" picking-mode="Ignore">
                    <Bindings>
                        <CottonCircuit.LocalizedText property="text" key="title.confirm.heading" />
                    </Bindings>
                </ui:Label>
                <ui:Label text="현재 진행 상황은 보관하고&#10;첫날부터 새롭게 시작합니다." class="title-confirmation-copy" picking-mode="Ignore">
                    <Bindings>
                        <CottonCircuit.LocalizedText property="text" key="title.confirm.copy" />
                    </Bindings>
                </ui:Label>
                <ui:VisualElement class="title-confirmation-actions">
                    <ui:Button name="TitleCancelNewGameButton" text="돌아가기" class="menu-button">
                        <Bindings>
                            <CottonCircuit.LocalizedText property="text" key="title.confirm.cancel" />
                        </Bindings>
                    </ui:Button>
                    <ui:Button name="TitleConfirmNewGameButton" text="새로 시작" class="menu-button menu-button-primary">
                        <Bindings>
                            <CottonCircuit.LocalizedText property="text" key="title.confirm.accept" />
                        </Bindings>
                    </ui:Button>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
