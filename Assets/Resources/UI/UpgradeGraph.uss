/* Growth map: authored per-tab trees. Node and edge geometry below mirrors UpgradeTreeLayout
   (disc centers in a 1048 x 550 map); the runtime smoke test checks that they agree. */
.prep-screen .prep-graph-paper { padding: 18px 20px 12px; background-color: #fffcf5; border-radius: 16px; }
.trait-graph-area { flex-grow: 1; min-height: 0; align-items: center; justify-content: center; overflow: hidden; }
.trait-graph { width: 1048px; height: 550px; flex-shrink: 0; }

.trait-node { position: absolute; width: 176px; align-items: center; }
.prep-screen .trait-node-button,
.prep-screen .trait-node-button:hover,
.prep-screen .trait-node-button:active,
.prep-screen .trait-node-button:focus {
    width: 74px;
    height: 74px;
    min-height: 0;
    margin: 0;
    padding: 0;
    border-width: 0;
    border-radius: 37px;
    background-color: rgba(0, 0, 0, 0);
}
.trait-ring { width: 74px; height: 74px; border-radius: 37px; align-items: center; justify-content: center; }
.trait-highlight .trait-ring { background-color: #d6a853; }
.trait-disc { width: 64px; height: 64px; border-radius: 32px; align-items: center; justify-content: center; background-color: #e7e9e2; }
/* Only a purchasable trait answers the pointer, as in the old graph; others still show details on hover. */
.trait-buyable .trait-node-button:hover .trait-disc { border-width: 2px; border-color: rgba(38, 59, 66, 0.3); }
.trait-buyable .trait-node-button:active .trait-disc { scale: 0.96 0.96; }
.trait-icon { width: 42px; height: 42px; margin-bottom: 6px; -unity-background-scale-mode: scale-to-fit; }
.trait-rank {
    position: absolute;
    left: 19px;
    top: 54px;
    width: 36px;
    height: 19px;
    padding: 0;
    border-radius: 9px;
    background-color: #263b42;
    color: #fffcf5;
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}
.trait-name {
    margin-top: 2px;
    height: 27px;
    padding: 0 6px;
    border-radius: 6px;
    background-color: #fffcf5;
    color: #263b42;
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: upper-center;
    white-space: nowrap;
}
.trait-locked .trait-icon { opacity: 0.55; }
.trait-locked .trait-name { color: #65736d; }

/* Open: bought or purchasable now. Reachable: prerequisites met, not affordable yet. */
.trait-open.trait-cat-business .trait-disc { background-color: #ebc997; }
.trait-open.trait-cat-production .trait-disc { background-color: #eba5b3; }
.trait-open.trait-cat-equipment .trait-disc { background-color: #b8d9cc; }
.trait-open.trait-cat-staff .trait-disc { background-color: #c9bde0; }
.trait-open.trait-cat-location .trait-disc { background-color: #acd2d9; }
.trait-open.trait-cat-sales .trait-disc { background-color: #e2c2ad; }
.trait-reachable.trait-cat-business .trait-disc { background-color: #f3dcbb; }
.trait-reachable.trait-cat-production .trait-disc { background-color: #f3c6cc; }
.trait-reachable.trait-cat-equipment .trait-disc { background-color: #d3e6dc; }
.trait-reachable.trait-cat-staff .trait-disc { background-color: #ded5e8; }
.trait-reachable.trait-cat-location .trait-disc { background-color: #cce2e4; }
.trait-reachable.trait-cat-sales .trait-disc { background-color: #edd8c8; }

.trait-chips { margin-top: 3px; }
.prep-screen .trait-chip {
    width: 176px;
    height: 21px;
    min-height: 21px;
    margin: 0 0 2px;
    padding: 0 8px;
    border-width: 0;
    border-radius: 10px;
    background-color: #f4e3d3;
    color: #263b42;
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: nowrap;
}
.prep-screen .trait-chip:hover { background-color: #eed4bd; }
.prep-screen .trait-chip-met { background-color: #ddede4; }
.prep-screen .trait-chip-met:hover { background-color: #c9e2d4; }

/* An edge is a line rotated about its start; the two heads fold back from its end. */
.trait-edge { position: absolute; height: 2.5px; transform-origin: 0 50%; background-color: #b4bdb2; }
.trait-edge-head { position: absolute; right: 0; top: 50%; width: 10px; height: 2.5px; margin-top: -1.25px; transform-origin: 100% 50%; background-color: #b4bdb2; }
.trait-edge-head-left { rotate: 32deg; }
.trait-edge-head-right { rotate: -32deg; }
.trait-edge-unlocked, .trait-edge-unlocked .trait-edge-head { background-color: #82ac9d; }
.trait-edge-focus { height: 3.5px; margin-top: -0.5px; }
.trait-edge-focus, .trait-edge-focus .trait-edge-head { background-color: #50796d; }

.trait-details { position: absolute; left: 0; top: 0; width: 330px; padding: 15px 20px; border-radius: 12px; background-color: #263b42; }
.trait-details-left { translate: -100% 0; }
.trait-details-up { translate: 0 -100%; }
.trait-details-left.trait-details-up { translate: -100% -100%; }
.trait-details-title { margin-bottom: 6px; color: #fff9ec; font-size: 16px; -unity-font-style: bold; }
.trait-details-body { color: #fff9ec; font-size: 14px; white-space: pre-wrap; }

