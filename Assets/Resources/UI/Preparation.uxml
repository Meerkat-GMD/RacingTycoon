      <ui:Label text="M I N A / 가게 친구" class="prep-companion-name"><Bindings><CottonCircuit.LocalizedText property="text" key="prep.companion.name" /></Bindings></ui:Label><ui:Label name="PreparationSpeech" text="Shall we start with a small step?" class="prep-speech" />
      <ui:Button name="OpenUpgradeGraph" text="01    성장 지도" class="prep-button prep-nav-button prep-selected"><Bindings><CottonCircuit.LocalizedText property="text" key="prep.nav.graph" /></Bindings></ui:Button>
      <ui:Button name="OpenEquipment" text="02    기계와 레시피" class="prep-button prep-nav-button"><Bindings><CottonCircuit.LocalizedText property="text" key="prep.nav.equipment" /></Bindings></ui:Button>
      <ui:Button name="OpenLocations" text="03    오늘의 장사" class="prep-button prep-nav-button"><Bindings><CottonCircuit.LocalizedText property="text" key="prep.nav.locations" /></Bindings></ui:Button>
      <ui:VisualElement class="prep-side-footer"><ui:Label text="한 바퀴씩, 우리만의 가게로." class="prep-footer-caption"><Bindings><CottonCircuit.LocalizedText property="text" key="prep.footer.caption" /></Bindings></ui:Label></ui:VisualElement>
    </ui:VisualElement>
  </ui:VisualElement>
</ui:UXML>
