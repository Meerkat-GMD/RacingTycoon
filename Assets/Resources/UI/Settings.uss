.settings-screen { position: absolute; left: 0; top: 0; right: 0; bottom: 0; align-items: center; justify-content: center; background-color: rgba(31, 38, 56, 0.6); color: #29324d; }
.settings-card { width: 640px; max-width: 94%; max-height: 96%; padding: 30px 38px 26px 38px; border-radius: 26px; background-color: #fff6e7; }
.settings-title { font-size: 34px; -unity-font-style: bold; margin-bottom: 10px; }
.settings-heading { font-size: 15px; color: #537f7e; -unity-font-style: bold; letter-spacing: 1px; margin: 14px 0 4px 4px; }
.settings-row { flex-direction: row; align-items: center; min-height: 50px; padding: 4px 12px; border-radius: 12px; border-width: 2px; border-color: rgba(0, 0, 0, 0); }
.settings-row:focus { border-color: #69bfc1; background-color: #dcefee; }
.settings-label { width: 190px; font-size: 20px; -unity-font-style: bold; white-space: nowrap; }
.settings-slider { flex-grow: 1; margin: 0 14px 0 0; }
.settings-slider .unity-base-slider__tracker { height: 10px; margin-top: -5px; background-color: #e9e3db; border-radius: 5px; border-width: 0; }
.settings-slider .unity-base-slider__dragger { width: 22px; height: 22px; margin-top: -11px; border-radius: 11px; background-color: #7acdce; border-width: 3px; border-color: #fffdf7; }
.settings-value { width: 60px; font-size: 18px; -unity-text-align: middle-right; color: #626573; }
.settings-toggle { margin-left: auto; min-width: 110px; min-height: 40px; font-size: 18px; -unity-font-style: bold; border-radius: 20px; background-color: #e9e3db; }
.settings-toggle.settings-on { background-color: #7acdce; color: #ffffff; }
.settings-choice { flex-grow: 1; flex-direction: row; align-items: center; justify-content: flex-end; }
.settings-choice-value { min-width: 170px; font-size: 19px; -unity-font-style: bold; -unity-text-align: middle-center; white-space: nowrap; }
.settings-arrow {
    width: 38px; height: 38px; min-height: 38px; padding: 0; border-radius: 19px; background-color: #fffdf7;
    background-image: url("project://database/Assets/CottonCircuit/UI/Art/ArrowRight.png");
    background-size: 16px 16px; background-position: center; background-repeat: no-repeat;
    -unity-background-image-tint-color: #29324d;
}
.settings-arrow-left { rotate: 180deg; }
.settings-arrow:hover { background-color: #dcefee; }
.settings-close { margin: 20px 0 0 0; -unity-text-align: middle-center; }
