              <ui:Label name="TraitDescription_patience" text="손님이 단계마다 12초 더 기다립니다." class="prep-trait-description" />
              <ui:Label name="TraitEffect_patience" text="현재 효과와 다음 단계 효과" class="prep-trait-effect" />
